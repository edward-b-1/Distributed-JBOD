# Settings for deploy/docker-compose.node.yml, one file per machine, read
# with --env-file. Only DJBOD_LISTEN and the two disks are required.
DJBOD_LISTEN=10.0.0.1:5263
# On every machine but the first: a running node to join through.
#DJBOD_JOIN_PEER=10.0.0.2:5263
# The other nodes, consulted at startup for a newer cluster document.
#DJBOD_BOOTSTRAP_PEERS=10.0.0.2:5263,10.0.0.3:5263
# The first machine only, when it creates the cluster.
#DJBOD_K=3
#DJBOD_M=1
#DJBOD_CLUSTER_NAME=home-nas
# Bind mounts: the state directory, and a directory inside each disk's
# mount point, all owned by uid 5263.
DJBOD_STATE_PATH=/var/lib/djbod
DJBOD_DISK0=/mnt/disk0/djbod
DJBOD_DISK1=/mnt/disk1/djbod
# TLS material, mounted into the container and named here (SPEC 19.1.6).
#DJBOD_TLS_CERT=/etc/djbod/nas1.crt
#DJBOD_TLS_KEY=/etc/djbod/nas1.key
#DJBOD_TLS_CA=/etc/djbod/ca.crt
