# /etc/djbod/client.env: how djbod-ui.service and djbod-scrub.service reach
# the cluster. The same variables work for `djbod` on the command line.
# djbod-ui reads DJBOD_BOOTSTRAP_NODE; djbod and the scrub read DJBOD_NODE;
# give both the same list, a local node first.
DJBOD_BOOTSTRAP_NODE=127.0.0.1:5263
DJBOD_NODE=127.0.0.1:5263
DJBOD_CLUSTER=00000000-0000-0000-0000-000000000000
# With TLS enabled on the cluster (SPEC 19.1.6):
#DJBOD_TLS_CA=/etc/djbod/ca.crt
#DJBOD_TLS_CERT=/etc/djbod/admin.crt
#DJBOD_TLS_KEY=/etc/djbod/admin.key
