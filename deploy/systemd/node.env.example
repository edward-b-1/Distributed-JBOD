# /etc/djbod/node.env: optional overrides for /etc/djbod/node.toml, read by
# djbod-node.service. An argument beats a variable, which beats the file
# (SPEC 20.6). Uncomment what you need.
#DJBOD_LISTEN=0.0.0.0:5263
#DJBOD_ADVERTISE=10.0.0.1:5263
#DJBOD_CLUSTER_NAME=home-nas        # read by init-cluster only; set-name changes it later
#DJBOD_TLS_CERT=/etc/djbod/nas1.crt
#DJBOD_TLS_KEY=/etc/djbod/nas1.key
#DJBOD_TLS_CA=/etc/djbod/ca.crt
#RUST_LOG=info
