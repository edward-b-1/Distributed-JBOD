# /etc/systemd/system/djbod-ui.service
#
# The administration web UI, talking to the node on this machine (or any
# other) with the client settings in /etc/djbod/client.env: DJBOD_NODE,
# DJBOD_CLUSTER, and DJBOD_TLS_CA, DJBOD_TLS_CERT, DJBOD_TLS_KEY when the
# cluster uses TLS. It listens on localhost; put it behind a reverse proxy
# with authentication if it must be reached from elsewhere.

[Unit]
Description=Distributed-JBOD administration web UI
Documentation=https://github.com/edward-b-1/Distributed-JBOD
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=djbod
Group=djbod
EnvironmentFile=/etc/djbod/client.env
ExecStart=/usr/local/bin/djbod-ui --listen 127.0.0.1:5264
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
