# systemd unit for the Distributed-JBOD administration web UI.
#
# Install:
#   sudo install -m 755 target/release/djbod-ui /usr/local/bin/djbod-ui
#   sudo install -m 644 deploy/systemd/djbod-ui.service /etc/systemd/system/
#   sudo install -m 640 -o root -g djbod deploy/systemd/client.env.example /etc/djbod/client.env
#   (edit /etc/djbod/client.env: DJBOD_BOOTSTRAP_NODE, DJBOD_CLUSTER, and
#    the DJBOD_TLS_* paths when the cluster's transport is tls)
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now djbod-ui
#
# The unit carries no site settings; they live in /etc/djbod/client.env,
# which djbod-scrub.service and the djbod command line read too. The UI
# does not need the node on this machine: it tries every address in
# DJBOD_BOOTSTRAP_NODE, then every node the cluster document lists.
#
# The UI has no login: anyone who can reach its address can administer the
# cluster. It listens on localhost; reach it with an SSH tunnel
# (ssh -L 5264:127.0.0.1:5264 <host>). To serve the LAN instead, use
# --listen 0.0.0.0:5264, and only on a network you trust. A request by
# host name is refused unless the name is given with --host <name>.

[Unit]
Description=Distributed-JBOD administration web UI
Documentation=https://github.com/edward-b-1/Distributed-JBOD
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=djbod
Group=djbod
EnvironmentFile=-/etc/djbod/client.env
ExecStart=/usr/local/bin/djbod-ui --listen 127.0.0.1:5264
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
